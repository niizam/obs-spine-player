// FXAA (Lottes' classic single-pass version) for the native Spine renderer's
// offscreen texture, which holds premultiplied RGBA over transparency.
//
// Edges are found from coverage (alpha) only, so FXAA smooths the character's
// outline, where mesh edges meet transparency, and leaves everything inside the
// character exactly as drawn. Detecting edges from colour would also treat the
// artwork's line art as aliasing and blur it. All four channels are filtered
// together, which keeps premultiplication intact (no halos).

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 texel;

sampler_state fxaa_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 PSFXAA(VertData vert_in) : TARGET
{
	float2 uv = vert_in.uv;
	float4 centre = image.Sample(fxaa_sampler, uv);
	float a_nw = image.Sample(fxaa_sampler, uv + float2(-1.0, -1.0) * texel).a;
	float a_ne = image.Sample(fxaa_sampler, uv + float2(1.0, -1.0) * texel).a;
	float a_sw = image.Sample(fxaa_sampler, uv + float2(-1.0, 1.0) * texel).a;
	float a_se = image.Sample(fxaa_sampler, uv + float2(1.0, 1.0) * texel).a;
	float a_m = centre.a;

	float a_min = min(a_m, min(min(a_nw, a_ne), min(a_sw, a_se)));
	float a_max = max(a_m, max(max(a_nw, a_ne), max(a_sw, a_se)));

	// Only filter real outline edges (Lottes' FXAA 3.11 console thresholds:
	// 0.125 of the largest neighbour, at least 0.05).
	if (a_max - a_min < max(0.05, a_max * 0.125))
		return centre;

	float2 dir;
	dir.x = -((a_nw + a_ne) - (a_sw + a_se));
	dir.y = ((a_nw + a_sw) - (a_ne + a_se));

	float dir_reduce = max((a_nw + a_ne + a_sw + a_se) * (0.25 * 0.125), 1.0 / 128.0);
	float rcp_dir_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + dir_reduce);
	dir = clamp(dir * rcp_dir_min, float2(-8.0, -8.0), float2(8.0, 8.0)) * texel;

	float4 rgba_a = 0.5 * (image.Sample(fxaa_sampler, uv + dir * (1.0 / 3.0 - 0.5)) +
			       image.Sample(fxaa_sampler, uv + dir * (2.0 / 3.0 - 0.5)));
	float4 rgba_b = rgba_a * 0.5 + 0.25 * (image.Sample(fxaa_sampler, uv + dir * -0.5) +
					       image.Sample(fxaa_sampler, uv + dir * 0.5));
	if (rgba_b.a < a_min || rgba_b.a > a_max)
		return rgba_a;
	return rgba_b;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSFXAA(vert_in);
	}
}
