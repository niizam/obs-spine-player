// FXAA (Lottes' classic single-pass version) for the native Spine renderer's
// offscreen texture. The texture holds premultiplied RGBA over transparency, so
// luma includes coverage (colour as seen over 50% grey) and all four channels
// are filtered together, which keeps premultiplication intact (no halos).

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 texel;

sampler_state fxaa_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float coverage_luma(float4 c)
{
	return sqrt(dot(c.rgb, float3(0.299, 0.587, 0.114)) + 0.5 * (1.0 - c.a));
}

float4 PSFXAA(VertData vert_in) : TARGET
{
	float2 uv = vert_in.uv;
	float4 centre = image.Sample(fxaa_sampler, uv);
	float luma_nw = coverage_luma(image.Sample(fxaa_sampler, uv + float2(-1.0, -1.0) * texel));
	float luma_ne = coverage_luma(image.Sample(fxaa_sampler, uv + float2(1.0, -1.0) * texel));
	float luma_sw = coverage_luma(image.Sample(fxaa_sampler, uv + float2(-1.0, 1.0) * texel));
	float luma_se = coverage_luma(image.Sample(fxaa_sampler, uv + float2(1.0, 1.0) * texel));
	float luma_m = coverage_luma(centre);

	float luma_min = min(luma_m, min(min(luma_nw, luma_ne), min(luma_sw, luma_se)));
	float luma_max = max(luma_m, max(max(luma_nw, luma_ne), max(luma_sw, luma_se)));

	float2 dir;
	dir.x = -((luma_nw + luma_ne) - (luma_sw + luma_se));
	dir.y = ((luma_nw + luma_sw) - (luma_ne + luma_se));

	float dir_reduce = max((luma_nw + luma_ne + luma_sw + luma_se) * (0.25 * 0.125), 1.0 / 128.0);
	float rcp_dir_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + dir_reduce);
	dir = clamp(dir * rcp_dir_min, float2(-8.0, -8.0), float2(8.0, 8.0)) * texel;

	float4 rgba_a = 0.5 * (image.Sample(fxaa_sampler, uv + dir * (1.0 / 3.0 - 0.5)) +
			       image.Sample(fxaa_sampler, uv + dir * (2.0 / 3.0 - 0.5)));
	float4 rgba_b = rgba_a * 0.5 + 0.25 * (image.Sample(fxaa_sampler, uv + dir * -0.5) +
					       image.Sample(fxaa_sampler, uv + dir * 0.5));
	float luma_b = coverage_luma(rgba_b);
	if (luma_b < luma_min || luma_b > luma_max)
		return rgba_a;
	return rgba_b;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSFXAA(vert_in);
	}
}
